{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "e2e": "playwright test --pass-with-no-tests",
    "frames": "tsx scripts/build-frames.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "gray-matter": "^4.0.3",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "exifr": "^7.1.3",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.2",
  "lint-staged": {
    "*.{js,mjs,json,css}": "prettier --write",
    "{README.md,.github/copilot-instructions.md}": "prettier --write",
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
